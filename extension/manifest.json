{
  "manifest_version": 3,
  "name": "OCR Platform - Mis documentos",
  "short_name": "OCR Platform",
  "version": "1.0.0",
  "description": "Tus documentos validados (INE, CURP, acta y pasaporte) a la mano: consulta y copia sus datos.",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icono-16.png",
    "32": "icons/icono-32.png",
    "48": "icons/icono-48.png",
    "128": "icons/icono-128.png"
  },
  "action": {
    "default_title": "OCR Platform - Mis documentos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icono-16.png",
      "32": "icons/icono-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://localhost/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
