# ═══════════════════════════════════════════════════════════════════════════
#  Configuración del sistema (copiar a .env).  Los scripts de arranque
#  (scripts/start.sh | scripts/start.ps1) generan .env con secretos aleatorios
#  si no existe. NUNCA subas .env a Git.
# ═══════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────────
APP_NAME=OCR Platform
TZ=America/Mexico_City
HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_URL=https://localhost:8443

# Perfiles de docker compose que se levantan:
#   ia            -> módulo de IA en contenedor (Linux + Tesseract)
#   ollama        -> Ollama en contenedor (Windows/Linux; en Mac usa Ollama nativo)
# Ej.: COMPOSE_PROFILES=ia,ollama     |  vacío = IA nativa (./scripts/start.sh --ia-nativa)
COMPOSE_PROFILES=ia

# ── Cuenta de administrador inicial (se crea al primer arranque) ─────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CambiaEstaContrasena123

# ── PostgreSQL (datos relacionales) ──────────────────────────────────────────
POSTGRES_DB=tt_ocr
POSTGRES_USER=tt_app
POSTGRES_PASSWORD=cambia-esto

# ── MongoDB (resultados OCR semiestructurados) ───────────────────────────────
MONGO_USER=tt_app
MONGO_PASSWORD=cambia-esto
MONGO_DB=tt_ocr

# ── Seguridad ────────────────────────────────────────────────────────────────
# JWT_SECRET: >= 32 caracteres aleatorios  (openssl rand -hex 32)
JWT_SECRET=
# DATA_ENCRYPTION_KEY: 32 bytes en base64 (openssl rand -base64 32).
# Cifra archivos y datos personales con AES-256-GCM. SI LA PIERDES, LOS DATOS
# CIFRADOS NO SE PUEDEN RECUPERAR. Respáldala fuera del proyecto.
DATA_ENCRYPTION_KEY=
# Clave compartida backend <-> módulo de IA (cabecera X-API-Key)
IA_API_KEY=
# Clave con la que se cifran los respaldos (backups/)
BACKUP_ENCRYPTION_KEY=

# Verificar el correo con un código al registrarse. El 2FA de inicio de sesión
# es opcional: cada usuario lo activa en Configuración.
REGISTRO_VERIFICAR_CORREO=true

# ── Correo (códigos 2FA y alertas de vigencia) ───────────────────────────────
# resend  -> envía correos reales con https://resend.com (requiere API key y
#            un dominio verificado con sus registros DNS SPF/DKIM).
# console -> desarrollo: el correo (y el código) se imprime en los logs:
#            docker compose logs -f backend
MAIL_PROVIDER=console
RESEND_API_KEY=
# Con el remitente de pruebas onboarding@resend.dev Resend SOLO entrega al
# correo dueño de la cuenta de Resend. Para enviar a cualquier dirección usa tu
# dominio verificado, p. ej.:  OCR Platform <no-reply@tudominio.com>
MAIL_FROM=OCR Platform <onboarding@resend.dev>
MAIL_REPLY_TO=

# ── Módulo de IA / Ollama ────────────────────────────────────────────────────
# Mac: Ollama nativo (Metal)            -> http://host.docker.internal:11434
# Windows/Linux con Ollama en Docker    -> http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Modelo sin razonamiento interno (responde directo el JSON): mucho más rápido
# que qwen2.5:7b y cabe en Macs de 8 GB. Alternativa más precisa: qwen2.5:7b
# Mantener el modelo cargado entre documentos (evita recargarlo cada vez)
OLLAMA_KEEP_ALIVE=30m
EXTRACTION_STRATEGY=llm_first
# Motor OCR de Docling: auto | ocrmac | tesseract | easyocr | rapidocr
OCR_ENGINE=auto
DOCLING_DEVICE=auto
DOCLING_TABLES=auto
PRELOAD_DOCLING_MODELS=true
# URL del módulo de IA vista desde el backend (cambia solo en modo --ia-nativa)
IA_URL=http://ia:5001
IA_CONCURRENCIA=1

# ── Reglas de negocio ────────────────────────────────────────────────────────
CURP_MAX_DIAS=90
ALERTAS_DIAS=90,30,7,0

# ── Respaldos ────────────────────────────────────────────────────────────────
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENCION=7
