---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
---
<Base titulo="Registro">
  <div class="pantalla-centrada">
    <div class="card caja-auth ancha">
      <a href="/" class="marca" style="margin-bottom:22px;text-decoration:none"><img src="/favicon.svg" alt="" /> OCR Platform</a>
      <div class="pasos" data-pasos>
        <span data-p="cuenta">1. Cuenta</span>
        <span data-p="codigo">2. Verificar correo</span>
        <span data-p="terminos">3. Privacidad</span>
        <span data-p="ine">4. INE</span>
        <span data-p="validar">5. Revisión</span>
      </div>
      <div data-mensaje></div>

      <!-- 1. Cuenta -->
      <section data-seccion="cuenta">
        <h1>Crea tu cuenta</h1>
        <p class="sub">Tu bóveda de identidad digital: tus documentos protegidos y listos para tus trámites.</p>
        <form data-form-cuenta style="margin-top:20px;max-width:520px">
          <div class="campo"><label for="r-correo">Correo electrónico</label><input id="r-correo" type="email" autocomplete="email" required /></div>
          <div class="campo"><label for="r-pass">Contraseña</label><input id="r-pass" type="password" autocomplete="new-password" minlength="10" required />
            <span class="ayuda">Mínimo 10 caracteres, con mayúscula, minúscula y número.</span></div>
          <div class="campo"><label for="r-pass2">Confirmar contraseña</label><input id="r-pass2" type="password" autocomplete="new-password" required /></div>
          <button class="btn btn-primario btn-grande">Continuar</button>
        </form>
        <p class="muted small" style="margin-top:18px">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
      </section>

      <!-- 2. Código -->
      <section data-seccion="codigo" class="oculto">
        <h1>Verifica tu correo</h1>
        <p class="sub">Enviamos un código de 6 dígitos a <b data-correo></b>.</p>
        <form data-form-codigo style="margin-top:20px;max-width:420px">
          <div class="campo"><label for="r-codigo">Código de verificación</label>
            <input id="r-codigo" class="codigo-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required /></div>
          <button class="btn btn-primario btn-grande">Verificar</button>
        </form>
        <p class="muted small" style="margin-top:18px">¿No llegó? <button class="link-btn" data-reenviar>Reenviar código</button></p>
      </section>

      <!-- 3. Términos -->
      <section data-seccion="terminos" class="oculto">
        <h1>Términos y condiciones</h1>
        <p class="sub">Lee cómo tratamos tus datos personales y documentos oficiales.</p>
        <div class="card" style="background:var(--bg);box-shadow:none;max-height:320px;overflow:auto;margin:18px 0" data-terminos></div>
        <div class="consentimientos-registro">
          <label><input type="checkbox" data-acepto /> Acepto los términos de uso.</label>
          <label><input type="checkbox" data-aviso /> He leído y acepto el aviso de privacidad.</label>
          <label><input type="checkbox" data-expreso /> Autorizo expresamente el procesamiento y almacenamiento protegido de mi INE para extraer datos y completar el registro.</label>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <button class="btn btn-primario btn-grande" data-aceptar disabled>Aceptar y continuar</button>
          <button class="btn btn-peligro" data-rechazar>No acepto (cancelar registro)</button>
        </div>
      </section>

      <!-- 4. INE obligatoria -->
      <section data-seccion="ine" class="oculto">
        <div class="registro-hero">
          <span class="registro-num">PASO 04 / 05</span>
          <h1>Tu identidad comienza aquí</h1>
          <p class="sub">Carga tu INE para extraer los datos de registro. Puedes revisar y corregir cualquier campo antes de guardarlo.</p>
        </div>
        <div class="registro-ayuda"><b>Documento obligatorio</b><span>PDF, JPG o PNG · máximo 10 MB · procura que el frente y el reverso sean legibles.</span></div>
        <form data-form-ine>
          <label for="r-ine" class="drop-ine"><strong>Seleccionar tu INE</strong><span>Haz clic para elegir un archivo. No uses documentos de otras personas.</span></label>
          <input id="r-ine" type="file" accept="application/pdf,image/jpeg,image/png" required class="input-ine" />
          <p class="muted small" data-archivo-elegido></p>
          <button type="submit" class="btn btn-primario btn-grande">Extraer información de mi INE</button>
        </form>
        <div class="registro-procesando oculto" data-procesando-ine aria-live="polite">
          <div class="spinner"></div><p data-estado-ine>Analizando el documento…</p>
        </div>
      </section>

      <!-- 5. Previsualización, corrección y confirmación -->
      <section data-seccion="validar" class="oculto">
        <div class="registro-hero"><span class="registro-num">PASO 05 / 05</span>
          <h1>Revisa los datos de tu INE</h1>
          <p class="sub">La extracción automática puede equivocarse. Confirma nombres, apellidos, CURP, domicilio y fecha de nacimiento antes de terminar.</p>
        </div>
        <div data-form-ine-validar></div>
        <button class="btn btn-borde" type="button" data-otra-ine>Cambiar INE</button>
      </section>

      <!-- Listo -->
      <section data-seccion="listo" class="oculto" style="text-align:center;padding:30px 0">
        <span class="icono icono-ok" style="margin-bottom:14px"><Icono nombre="check" tam={32} /></span>
        <h1>Registro completado</h1>
        <p class="sub">Tu INE fue confirmada y tu perfil está listo. Te mostraremos la guía de la plataforma.</p>
      </section>
    </div>
  </div>
</Base>

<script>
  import { api } from '../lib/api';
  import { TERMINOS_HTML } from '../lib/terminos';
  import { confirmar, esc, limpiar, mostrarError, toast } from '../lib/ui';
  import { esperarProcesamiento, renderValidacion } from '../lib/validacion';

  const ORDEN = ['cuenta', 'codigo', 'terminos', 'ine', 'validar'];
  const msg = document.querySelector('[data-mensaje]') as HTMLElement;
  let correo = '';

  function ir(seccion: string) {
    limpiar(msg);
    document.querySelectorAll<HTMLElement>('[data-seccion]').forEach((s) => s.classList.toggle('oculto', s.dataset.seccion !== seccion));
    const idx = seccion === 'listo' ? ORDEN.length : ORDEN.indexOf(seccion);
    document.querySelectorAll<HTMLElement>('[data-p]').forEach((p) => {
      const i = ORDEN.indexOf(p.dataset.p!);
      p.classList.toggle('activo', i === idx);
      p.classList.toggle('hecho', i < idx);
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  (document.querySelector('[data-terminos]') as HTMLElement).innerHTML = TERMINOS_HTML;

  // 1. Cuenta
  document.querySelector('[data-form-cuenta]')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    correo = (document.getElementById('r-correo') as HTMLInputElement).value.trim().toLowerCase();
    const p1 = (document.getElementById('r-pass') as HTMLInputElement).value;
    const p2 = (document.getElementById('r-pass2') as HTMLInputElement).value;
    if (p1 !== p2) return mostrarError(msg, { message: 'Las contraseñas no coinciden' });
    const b = (e.target as HTMLFormElement).querySelector('button')!;
    b.disabled = true;
    try {
      const r = await api('/auth/registro', { cuerpo: { correo, password: p1 }, redirigir401: false });
      (document.querySelector('[data-correo]') as HTMLElement).textContent = correo;
      ir(r.requiereCodigo === false ? 'terminos' : 'codigo');
    } catch (err) {
      mostrarError(msg, err);
    } finally {
      b.disabled = false;
    }
  });

  // 2. Código de verificación del correo
  document.querySelector('[data-form-codigo]')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const codigo = (document.getElementById('r-codigo') as HTMLInputElement).value.trim();
    try {
      await api('/auth/registro/verificar', { cuerpo: { correo, codigo }, redirigir401: false });
      ir('terminos');
    } catch (err) {
      mostrarError(msg, err);
    }
  });
  document.querySelector('[data-reenviar]')!.addEventListener('click', async () => {
    try {
      await api('/auth/registro/reenviar', { cuerpo: { correo }, redirigir401: false });
      toast('Código reenviado', 'ok');
    } catch (err: any) {
      toast(err.message, 'error');
    }
  });

  // 3. Aceptación versionada. La sesión completa NO se crea al aceptar.
  const acepto = document.querySelector('[data-acepto]') as HTMLInputElement;
  const aviso = document.querySelector('[data-aviso]') as HTMLInputElement;
  const expreso = document.querySelector('[data-expreso]') as HTMLInputElement;
  const btnAceptar = document.querySelector('[data-aceptar]') as HTMLButtonElement;
  const actualizarConsentimiento = () => btnAceptar.disabled = !(acepto.checked && aviso.checked && expreso.checked);
  [acepto, aviso, expreso].forEach((c) => c.addEventListener('change', actualizarConsentimiento));
  btnAceptar.addEventListener('click', async () => {
    btnAceptar.disabled = true;
    try {
      await api('/auth/registro/terminos', { cuerpo: {
        acepta: true, aceptaAviso: true, consentimientoExpreso: true,
      }, redirigir401: false });
      ir('ine');
    } catch (err: any) {
      actualizarConsentimiento();
      if (err.status === 401) return ir('cuenta');
      mostrarError(msg, err);
    }
  });

  // 4. Subida y procesamiento obligatorio de la INE.
  const formIne = document.querySelector('[data-form-ine]') as HTMLFormElement;
  const inputIne = document.getElementById('r-ine') as HTMLInputElement;
  let ineId: number | null = null;
  inputIne.addEventListener('change', () => {
    (document.querySelector('[data-archivo-elegido]') as HTMLElement).textContent = inputIne.files?.[0]?.name ?? '';
  });

  async function revisarINE(id: number) {
    ineId = id;
    ir('ine');
    const proceso = document.querySelector('[data-procesando-ine]') as HTMLElement;
    const estadoEl = document.querySelector('[data-estado-ine]') as HTMLElement;
    proceso.classList.remove('oculto');
    formIne.classList.add('oculto');
    try {
      const estado = await esperarProcesamiento(id, (e) => {
        estadoEl.textContent = e === 'cargado' ? 'Archivo recibido y protegido…' : 'Extrayendo y verificando los datos…';
      }, '/auth/registro/ine');
      if (estado.estado === 'validado') return await finalizar();
      if (estado.estado !== 'procesado') throw new Error(estado.motivo_rechazo ?? 'No fue posible procesar la INE. Prueba con una imagen más legible.');
      const doc = await api(`/auth/registro/ine/${id}`, { redirigir401: false });
      ir('validar');
      renderValidacion(document.querySelector('[data-form-ine-validar]') as HTMLElement, doc,
        async () => { await finalizar(); }, 'Confirmar INE y completar registro', 'validar', '/auth/registro/ine');
    } catch(err) {
      ir('ine');
      mostrarError(msg, err);
    } finally {
      proceso.classList.add('oculto');
      formIne.classList.remove('oculto');
    }
  }
  async function finalizar() {
    try {
      const r = await api('/auth/registro/finalizar', { cuerpo: {}, redirigir401: false });
      ir('listo');
      location.assign(r.redirigir ?? '/app/tutorial');
    } catch (err) { mostrarError(msg, err); }
  }
  formIne.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = inputIne.files?.[0];
    if (!f) return mostrarError(msg, new Error('Selecciona tu INE.'));
    if (!['application/pdf', 'image/jpeg', 'image/png'].includes(f.type) || f.size > 10 * 1024 * 1024)
      return mostrarError(msg, new Error('Usa PDF, JPG o PNG, máximo 10 MB.'));
    const datos = new FormData(); datos.append('archivo',f);
    const boton = formIne.querySelector('button') as HTMLButtonElement;
    boton.disabled = true;
    try {
      const doc = await api('/auth/registro/ine', { form: datos, redirigir401:false });
      await revisarINE(doc.id);
    } catch (err) { mostrarError(msg,err); }
    finally { boton.disabled = false; }
  });
  document.querySelector('[data-otra-ine]')!.addEventListener('click', () => ir('ine'));

  document.querySelector('[data-rechazar]')!.addEventListener('click', async () => {
    if (!(await confirmar('Cancelar registro', 'Sin aceptar los términos no es posible crear tu cuenta. Se eliminará la información capturada.', 'Cancelar registro', true))) return;
    await api('/auth/registro/terminos', { cuerpo: { acepta: false }, redirigir401: false }).catch(() => undefined);
    location.href = '/';
  });

  // Reanudar un registro en curso o continuar desde el inicio de sesión
  (async () => {
    const q = new URLSearchParams(location.search);
    try {
      const est = await api('/auth/registro/estado', { redirigir401: false });
      correo = est.correo;
      if (!est.terminos_aceptados) return ir('terminos');
      const d = await api('/auth/registro/ine/ultima', { redirigir401:false });
      if (d.id && ['cargado','procesando','procesado','validado'].includes(d.estado)) return void revisarINE(d.id);
      return ir('ine');
    } catch {
      /* sin registro en curso */
    }
    if (q.get('continuar')) {
      correo = q.get('continuar')!.toLowerCase();
      (document.querySelector('[data-correo]') as HTMLElement).textContent = correo;
      ir('codigo');
      msg.innerHTML = `<div class="alerta alerta-info">Tu registro está incompleto. Enviamos un código a <b>${esc(correo)}</b> para continuarlo.</div>`;
      return;
    }
    ir('cuenta');
  })();
</script>
