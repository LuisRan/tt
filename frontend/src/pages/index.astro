---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
---
<Base titulo="Inicio">
  <div class="landing">
    <section class="hero">
      <div>
        <h1>Plataforma de validación y procesamiento <span class="grad">OCR + IA</span></h1>
        <p class="lead">Automatiza la extracción y validación de documentos oficiales mediante OCR, inteligencia artificial y autenticación segura.</p>
        <div class="acciones">
          <a class="btn btn-primario btn-grande" href="/login">Iniciar sesión</a>
          <a class="btn btn-borde btn-grande" href="/registro">Registrarse</a>
        </div>
        <div class="caracteristicas">
          <div class="card"><h3>OCR Inteligente</h3><p>Extracción automática de datos de INE, CURP, acta de nacimiento y pasaporte.</p></div>
          <div class="card"><h3>Seguridad multicapa</h3><p>Autenticación en dos pasos, cifrado AES-256 y HTTPS.</p></div>
          <div class="card"><h3>Validación IA</h3><p>Procesamiento local con LLM y verificación anti-alucinación.</p></div>
        </div>
      </div>
      <div class="card maqueta" aria-hidden="true">
        <div class="barra-ventana"><span><i></i><i></i><i></i></span><span>Dashboard OCR</span></div>
        <div style="padding:30px">
          <div class="zona-subida">
            <span class="icono icono-grande"><Icono nombre="documento" tam={32} /></span>
            <h3>Subir documento</h3>
            <span class="muted">INE · CURP · Acta · Pasaporte</span>
            <a class="btn btn-primario" href="/registro" tabindex="-1">Seleccionar archivo</a>
          </div>
          <div class="card" style="margin-top:22px;background:var(--panel-2);box-shadow:none">
            <h3 style="margin-bottom:12px">Datos detectados</h3>
            <p style="margin:6px 0"><b>Nombre:</b> Juan Pérez</p>
            <p style="margin:6px 0"><b>CURP:</b> PEJJ000101HDFXXX09</p>
            <p style="margin:6px 0"><b>Documento:</b> INE</p>
            <p style="margin:6px 0"><b>Estado:</b> <span class="estado-ok">Validado</span></p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
<script>
  // Si ya hay sesión, ir directo al panel
  fetch('/api/auth/yo', { credentials: 'same-origin' })
    .then((r) => (r.ok ? r.json() : null))
    .then((yo) => {
      if (yo) {
        const b = document.querySelector('.hero .acciones');
        if (b) b.innerHTML = `<a class="btn btn-primario btn-grande" href="${yo.rol === 'administrador' ? '/admin' : '/app'}">Ir a mi panel</a>`;
      }
    })
    .catch(() => undefined);
</script>
